# ==============================================================================
# inu-agent-web Environment Variables Template
#
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR HOSTS TO VERSION CONTROL.
# Copy this file to .env and configure with your actual environment values.
# ==============================================================================

# Backend inu-agent-core URL (e.g. http://localhost:8000 or https://agent-api.inu.ac.kr)
VITE_AGENT_CORE_URL=http://localhost:8000

# Default Client Tenant (INTIP or UNIDORM)
VITE_DEFAULT_CLIENT=INTIP
